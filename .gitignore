# Root .gitignore for SIPERPU (Laravel Backend + React Frontend Monorepo)

# Backend
backend/vendor/
backend/.env
backend/.env.backup
backend/.env.production
backend/storage/*.key
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/database/*.sqlite
backend/.phpunit.cache/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# OS / Editor files
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
